import os
import re
import shlex

configfile: "workflow/config.yaml"
report: config.get("report_description", "report/workflow.rst")

# Resolve repository-owned files without embedding a checkout-specific absolute path.
repo_root = os.path.abspath(os.path.join(workflow.basedir, ".."))


def repo_path(path):
    return path if os.path.isabs(path) else os.path.join(repo_root, path)


def _cli_value(value):
    if isinstance(value, bool):
        return "true" if value else "false"
    return shlex.quote(str(value))


def hydro_cli_options(test=None, include_global=True):
    """Return scheme-specific Hydro overrides without hard-coding a method in rules."""
    options = dict(config.get("hydro_options", {})) if include_global else {}
    if test is not None:
        options.update(test.get("hydro_options", {}))
    return " ".join(
        f"hydro/{name}={_cli_value(value)}" for name, value in options.items()
    )


def output_variable_list(test, default=("prim",)):
    variables = test.get("output_variables", default)
    if isinstance(variables, str):
        return variables
    return ",".join(variables)


# Configure where simulation kernels execute independently of the numerical
# method. CPU configurations inherit the historical module stack and request no
# GPU; diagnostics remain ordinary CPU jobs in either case.
EXECUTION = config.get("execution", {})
SIMULATION_ENVMODULES = EXECUTION.get(
    "envmodules", ["foss/2023a", "HDF5/1.14.0-gompi-2023a"]
)
SIMULATION_GPU_COUNT = int(
    os.environ.get("ATHENAPK_LOCAL_GPU_COUNT", EXECUTION.get("gpus", 0))
)
SIMULATION_TASKS_PER_GPU = int(EXECUTION.get("tasks_per_gpu", 1))
SIMULATION_CPUS_PER_GPU = int(EXECUTION.get("cpus_per_gpu", 1))
SIMULATION_CONSTRAINT = EXECUTION.get("constraint")
SIMULATION_QOS = EXECUTION.get("qos")
SIMULATION_SLURM_EXTRA = EXECUTION.get("slurm_extra", "")
NGHOST = int(config.get("nghost", 3))

# A suite configuration may select tests with one compact list rather than
# repeating enabled: true/false in every test block.  Configurations without
# enabled_tests retain the historical per-test enabled flags.
ENABLED_TESTS = config.get("enabled_tests")
SUITE_TEST_DIMENSIONS = {
    "cpaw": {"2D", "3D"},
    "field_loop": {"2D", "3D"},
    "orszag_tang": {"2D"},
    "current_sheet": {"2D"},
    "mhd_cloud_shock": {"3D"},
    "mhd_blast": {"3D"},
}

if SIMULATION_GPU_COUNT < 0:
    raise ValueError("execution/gpus cannot be negative")
if SIMULATION_TASKS_PER_GPU < 1:
    raise ValueError("execution/tasks_per_gpu must be positive")
if SIMULATION_CPUS_PER_GPU < 1:
    raise ValueError("execution/cpus_per_gpu must be positive")
if NGHOST < 1:
    raise ValueError("nghost must be positive")
if ENABLED_TESTS is not None:
    if not isinstance(ENABLED_TESTS, list):
        raise ValueError("enabled_tests must be a list")
    if any(not isinstance(test, str) for test in ENABLED_TESTS):
        raise ValueError("enabled_tests entries must be strings")
    if len(ENABLED_TESTS) != len(set(ENABLED_TESTS)):
        raise ValueError("enabled_tests contains duplicate entries")

    unknown_tests = sorted(set(ENABLED_TESTS) - set(SUITE_TEST_DIMENSIONS))
    if unknown_tests:
        raise ValueError(
            "enabled_tests contains unsupported suite tests: "
            + ", ".join(unknown_tests)
        )

    dimension = config.get("dimension")
    incompatible_tests = sorted(
        test
        for test in ENABLED_TESTS
        if dimension not in SUITE_TEST_DIMENSIONS[test]
    )
    if incompatible_tests:
        raise ValueError(
            f"The following tests do not support dimension={dimension}: "
            + ", ".join(incompatible_tests)
        )

    for test_name, test_config in config.get("tests", {}).items():
        test_config["enabled"] = test_name in ENABLED_TESTS


for executable_key in ("athenapk", "athenapk_mpi", "athenapk_mpi_hdf5"):
    if executable_key in config:
        config[executable_key] = repo_path(config[executable_key])

for test in config.get("tests", {}).values():
    for path_key in (
        "input",
        "order_script",
        "plotting_script",
        "field_line_script",
        "energy_plotting_script",
        "slice_plotting_script",
        "spectrum_plotting_script",
    ):
        if path_key in test:
            test[path_key] = repo_path(test[path_key])

# Keep results from different numerical experiments separate even when they share a
# base directory. Individual rules continue to use config["results_root"].
base_results_root = repo_path(config["results_root"]).rstrip("/")
scheme_id = config.get("scheme_id", "common")
config["results_root"] = f"{base_results_root}/{scheme_id}"

include: "rules/smooth_vortex.smk"
include: "rules/linear_wave.smk"
include: "rules/linear_wave_directions.smk"
include: "rules/field_loop.smk"
include: "rules/field_loop_orientations.smk"
include: "rules/orszag_tang.smk"
include: "rules/current_sheet.smk"
include: "rules/mhd_cloud_shock.smk"
include: "rules/mhd_blast.smk"
include: "rules/turbulence.smk"
include: "rules/cpaw.smk"
include: "rules/cpaw_viz.smk"





rule all:
    input:
        smooth_vortex_targets,
        linear_wave_targets,
        linear_wave_direction_targets,
        field_loop_targets,
        field_loop_orientation_targets,
        orszag_tang_targets,
        current_sheet_targets,
        mhd_cloud_shock_targets,
        mhd_blast_targets,
        turbulence_targets,
        cpaw_targets,
        cpaw_viz_targets
