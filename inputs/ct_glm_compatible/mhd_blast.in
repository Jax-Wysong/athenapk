<comment>
problem = 3D C1 MHD blast wave from Berta et al. (2024), Section 5.7

<parthenon/job>
problem_id = mhd_blast

<job>
problem_id = mhd_blast

<parthenon/mesh>
refinement = none
nghost = 3

nx1 = 192
x1min = -0.5
x1max = 0.5
ix1_bc = outflow
ox1_bc = outflow

nx2 = 192
x2min = -0.5
x2max = 0.5
ix2_bc = outflow
ox2_bc = outflow

nx3 = 192
x3min = -0.5
x3max = 0.5
ix3_bc = outflow
ox3_bc = outflow

<parthenon/meshblock>
nx1 = 48
nx2 = 48
nx3 = 48

<parthenon/time>
integrator = rk4
cfl = 0.3
tlim = 0.2
nlim = -1
perf_cycle_offset = 2

<hydro>
fluid = ucthlldmhd
eos = adiabatic
riemann = hlld
reconstruction = wenoz_point
convergence_order = 4
discontinuity_detector = hod
discontinuity_detector_threshold = 0.5
discontinuity_detector_epsilon = 1.0e-12
gamma = 1.666666666666667
scratch_level = 1

<problem/mhd_blast>
radius = 0.1
x1_0 = 0.0
x2_0 = 0.0
x3_0 = 0.0
density_inner = 1.0
density_ambient = 1.0
pressure_inner = 10.0
pressure_ambient = 0.1
b0 = 3.0
theta = 1.5707963267948966
phi = 0.7853981633974483

<parthenon/output0>
file_type = hdf5
dt = 0.01
variables = prim,berta24_troubled
include_in_final = true
use_final_label = true

<parthenon/output1>
file_type = hst
dt = 0.01
