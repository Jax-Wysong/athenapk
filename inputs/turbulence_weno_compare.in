<comment>
problem   = Driven MHD turbulence GLM/UCT-HLLD comparison
reference = https://gitlab.com/pgrete/kathena/-/wikis/turbulence

<job>
problem_id = turbulence

<parthenon/output1>
file_type = hst
dt        = 0.005

<parthenon/output2>
file_type               = hdf5
variables               = prim,acc
dt                      = 5.0
id                      = prim
single_precision_output = true

<parthenon/output3>
file_type = rst
dt        = 5.0
id        = restart

<parthenon/time>
cfl             = 0.3
nlim            = 1000000
tlim            = 15.0
integrator      = vl2
ncycle_out_mesh = -500

<parthenon/mesh>
nghost = 3
nx1    = 128
x1min  = 0.0
x1max  = 1.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 128
x2min  = 0.0
x2max  = 1.0
ix2_bc = periodic
ox2_bc = periodic

nx3    = 128
x3min  = 0.0
x3max  = 1.0
ix3_bc = periodic
ox3_bc = periodic

packs_per_rank = 1

<parthenon/meshblock>
nx1 = 64
nx2 = 64
nx3 = 32

<hydro>
fluid                    = glmmhd
eos                      = adiabatic
riemann                  = hlld
reconstruction           = wenoz
gamma                    = 1.0001
first_order_flux_correct = true

<problem/turbulence>
rho0         = 1.0                      # initial mean density
p0           = 1.0                      # initial mean pressure
b0           = 0.1414213562373095       # initial magnetic field (x-direction)
b_config     = 0                        # 0 - net flux; 1 - no net flux uniform B; 2 - non net flux sin B; 4 - field loop
kpeak        = 2.0                      # characteristic wavenumber
corr_time    = 1.0                      # autocorrelation time of the OU forcing process
rseed        = 20190729                 # random seed of the OU forcing process
sol_weight   = 1.0                      # solenoidal weight of the acceleration field
accel_rms    = 1.0                      # root mean square value of the acceleration field
num_modes    = 30                       # number of wavemodes

<modes>
k_1_0  = +2
k_1_1  = -1
k_1_2  = +0
k_2_0  = +1
k_2_1  = +0
k_2_2  = +2
k_3_0  = +1
k_3_1  = +1
k_3_2  = -1
k_4_0  = +2
k_4_1  = +0
k_4_2  = +1
k_5_0  = +0
k_5_1  = +0
k_5_2  = -1
k_6_0  = +1
k_6_1  = -1
k_6_2  = -2
k_7_0  = +0
k_7_1  = +0
k_7_2  = -2
k_8_0  = +1
k_8_1  = +0
k_8_2  = -1
k_9_0  = +0
k_9_1  = +2
k_9_2  = +1
k_10_0 = +0
k_10_1 = -1
k_10_2 = +2
k_11_0 = +0
k_11_1 = +0
k_11_2 = +2
k_12_0 = +0
k_12_1 = +2
k_12_2 = -1
k_13_0 = +2
k_13_1 = +1
k_13_2 = +1
k_14_0 = +1
k_14_1 = -1
k_14_2 = +0
k_15_0 = +0
k_15_1 = -1
k_15_2 = -1
k_16_0 = +1
k_16_1 = +0
k_16_2 = +1
k_17_0 = +0
k_17_1 = -1
k_17_2 = +1
k_18_0 = +0
k_18_1 = +1
k_18_2 = +0
k_19_0 = +1
k_19_1 = -1
k_19_2 = +1
k_20_0 = +2
k_20_1 = +1
k_20_2 = -1
k_21_0 = +0
k_21_1 = -1
k_21_2 = -2
k_22_0 = +2
k_22_1 = -1
k_22_2 = +1
k_23_0 = +0
k_23_1 = +1
k_23_2 = +1
k_24_0 = +1
k_24_1 = -2
k_24_2 = +1
k_25_0 = +1
k_25_1 = -2
k_25_2 = +0
k_26_0 = +1
k_26_1 = +2
k_26_2 = +0
k_27_0 = +1
k_27_1 = -2
k_27_2 = -1
k_28_0 = +2
k_28_1 = -1
k_28_2 = -1
k_29_0 = +1
k_29_1 = +2
k_29_2 = -1
k_30_0 = +1
k_30_1 = +1
k_30_2 = +2
